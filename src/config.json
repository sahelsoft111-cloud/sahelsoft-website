  "about": {
    "title": "Des logiciels de gestion pensés pour les entreprises du Sahel",
    "intro": "SahelSoft est un éditeur de logiciels de gestion basé à Bamako, au Mali. Nous concevons des applications simples et fiables pour les commerces, PME, exploitations agricoles et organisations d’Afrique de l’Ouest : caisse, facturation, stock, paie, fiscalité, immobilisations, agriculture et gestion de flotte.",
    "mission": "Rendre les outils de gestion professionnels accessibles à toutes les entreprises africaines, quelle que soit leur taille, pour les aider à mieux s’organiser, à respecter leurs obligations et à prendre de meilleures décisions.",
    "vision": "Devenir la référence des logiciels de gestion adaptés aux réalités de l’Afrique de l’Ouest : connexion limitée, paiements mobiles et réglementations locales.",
    "commitments": [
      {
        "icon": "terrain",
        "title": "Adaptés au terrain",
        "text": "Utilisables hors connexion, en FCFA, avec Mobile Money, sur téléphone comme sur ordinateur."
      },
      {
        "icon": "conformite",
        "title": "Conformes aux règles locales",
        "text": "ITS, INPS, AMO, impôt synthétique et SYSCOHADA révisé intégrés dans nos logiciels."
      },
      {
        "icon": "donnees",
        "title": "Vos données vous appartiennent",
        "text": "Enregistrées sur votre appareil, jamais revendues. Vous gardez le contrôle."
      },
      {
        "icon": "support",
        "title": "Un accompagnement de proximité",
        "text": "Installation, prise en main et assistance réactive par WhatsApp et e-mail."
      }
    ]
  }
}
